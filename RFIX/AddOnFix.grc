// Language-independent resources — pattern copied from
// GRAPHISOFT/archicad-addon-cmake's RFIX/AddOnFix.grc (MIT licensed).
//
// Real, registered MDID (from https://archicadapi.graphisoft.com) —
// replaces Graphisoft's placeholder demo pair (1/1), which Archicad
// refuses to load in a real (non-demo) copy.
'MDID' 32500 "Add-On Identifier" {
	960840759 /* developer id */
	1963806355 /* local id */
}

'GICN' 10001 "AddOnIcon" {
	"AddOnIcon"
}
