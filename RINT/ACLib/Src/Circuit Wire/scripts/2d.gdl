! Circuit Wire — 2D Script
!
! Draws a single circular-arc curve in the floor plan from the
! placement origin (0,0) to (endX, endY), bowed perpendicular to the
! straight chord by `bulge`. bulge = 0 draws a plain line2.
!
! This is deliberately NOT a true multi-tangent spline — the brief was
! "curve in 2D, endpoints have to match, the exact shape doesn't" — so
! a single arc through a computed midpoint is enough, and it only
! needs arc2/line2 plus plain algebra: both are long-stable, safe-to-
! trust GDL commands (confirmed lowercase-command style against
! GRAPHISOFT/archicad-addon-cmake's SampleObject, which uses
! "rect2 0, 0, a, b"). Only endX/endY/bulge are ever written from the
! C++ side (Src/Wiring/GdlWireElement.cpp) — nothing else in this
! script is addon-controlled.
!
! GDL math functions are NOT C-style — confirmed against the real GDL
! Reference Guide (gdl.graphisoft.com/reference-guide/functions/):
! SQR(x) is square root (not sqrt), and ATN(x) is arctangent, but
! single-argument only (-90 <= ATN(x) <= 90 degrees) — there is no
! built-in two-argument atan2. The previous version of this script used
! nonexistent sqrt()/atan2() names; fixed below, with a11/a2's
! quadrant-correct angle computed manually from ATN since GDL doesn't
! provide that itself. GDL angles are in degrees throughout (matches
! ATN's documented -90/90 degree range), so no radian conversion needed
! anywhere here.

eps = 0.0001

chordLen = SQR(endX * endX + endY * endY)

if chordLen < eps then
	goto 90
endif

if abs(bulge) < eps then
	line2 0, 0, endX, endY
	goto 90
endif

! Midpoint of the curve: chord midpoint, offset perpendicular to the
! chord by `bulge`.
mx = endX / 2 - (endY / chordLen) * bulge
my = endY / 2 + (endX / chordLen) * bulge

! Circumcenter of (0,0), (mx,my), (endX,endY) — standard 3-point
! circle formula (2*D = 0 would mean the three points are collinear,
! which bulge != 0 and chordLen >= eps should already rule out, but
! it's checked anyway).
d = 2 * (0 * (my - endY) + mx * (endY - 0) + endX * (0 - my))

if abs(d) < eps then
	line2 0, 0, endX, endY
	goto 90
endif

cx = ((mx*mx + my*my) * (endY - 0) + (endX*endX + endY*endY) * (0 - my)) / d
cy = ((mx*mx + my*my) * (0 - endX) + (endX*endX + endY*endY) * (mx - 0)) / d

r = SQR((cx - 0) * (cx - 0) + (cy - 0) * (cy - 0))

! Angle from center to (0,0), quadrant-correct, built from ATN by hand.
v1x = 0 - cx
v1y = 0 - cy
if v1x = 0 then
	if v1y > 0 then
		a1 = 90
	else
		a1 = -90
	endif
else
	a1 = ATN(v1y / v1x)
	if v1x < 0 then
		if v1y >= 0 then
			a1 = a1 + 180
		else
			a1 = a1 - 180
		endif
	endif
endif

! Same, for (endX, endY).
v2x = endX - cx
v2y = endY - cy
if v2x = 0 then
	if v2y > 0 then
		a2 = 90
	else
		a2 = -90
	endif
else
	a2 = ATN(v2y / v2x)
	if v2x < 0 then
		if v2y >= 0 then
			a2 = a2 + 180
		else
			a2 = a2 - 180
		endif
	endif
endif

arc2 cx, cy, r, a1, a2

90:
